-- ===================== ФУНКЦИИ =====================
local function getKnife()
    local char = LocalPlayer.Character
    if not char then return nil end
    local knife = char:FindFirstChild("Knife")
    if knife then return knife end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then return bp:FindFirstChild("Knife") end
    return nil
end

local function getGun()
    local char = LocalPlayer.Character
    if not char then return nil end
    local gun = char:FindFirstChild("Gun")
    if gun then return gun end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then return bp:FindFirstChild("Gun") end
    return nil
end

local function isMurderer(plr)
    if not plr.Character then return false end
    local bp = plr:FindFirstChild("Backpack")
    return plr.Character:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife"))
end

-- Murder логика
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    -- Auto Equip
    if AutoEquipKnife then
        local knife = getKnife()
        if knife and knife.Parent == LocalPlayer.Backpack then
            hum:EquipTool(knife)
        end
    end

    local knife = char:FindFirstChild("Knife")
    if not knife then return end

    -- Kill Aura / Kill All
    if KillAura or KillAll then
        local radius = KillAll and 90 or KillAuraRadius
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr \~= LocalPlayer and plr.Character then
                local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                local tHum = plr.Character:FindFirstChildOfClass("Humanoid")
                if tRoot and tHum and tHum.Health > 0 then
                    local dist = (tRoot.Position - root.Position).Magnitude
                    if dist <= radius then
                        if FaceTarget then
                            root.CFrame = CFrame.lookAt(root.Position, tRoot.Position)
                        end
                        knife:Activate()
                    end
                end
            end
        end
    end

    -- Auto Knife
    if AutoKnife then
        knife:Activate()
    end
end)

-- Sheriff логика
RunService.RenderStepped:Connect(function()
    -- Auto Grab Gun
    if AutoGrabGun then
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj.Name == "Gun" and obj:IsA("Tool") then
                local handle = obj:FindFirstChild("Handle")
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if handle and myRoot and (handle.Position - myRoot.Position).Magnitude < 20 then
                    obj.Parent = LocalPlayer.Backpack
                end
            end
        end
    end

    local gun = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Gun")
    if not gun then return end

    if GunSilentAim or Triggerbot or AutoKillMurderer then
        local target = nil

        if AutoKillMurderer then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr \~= LocalPlayer and isMurderer(plr) then
                    local tHum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
                    if tHum and tHum.Health > 0 then
                        target = plr
                        break
                    end
                end
            end
        else
            local closest, closestDist = nil, 250
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr \~= LocalPlayer and plr.Character then
                        local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                        local tHum = plr.Character:FindFirstChildOfClass("Humanoid")
                        if tRoot and tHum and tHum.Health > 0 then
                            local dist = (tRoot.Position - myRoot.Position).Magnitude
                            if dist < closestDist then
                                closest = plr
                                closestDist = dist
                            end
                        end
                    end
                end
            end
            target = closest
        end

        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local targetPos = target.Character.HumanoidRootPart.Position + Vector3.new(0, 2, 0)

            if GunSilentAim or AutoKillMurderer then
                local camCF = Camera.CFrame
                local goal = CFrame.new(camCF.Position, targetPos)
                Camera.CFrame = camCF:Lerp(goal, math.clamp(GunSmooth / 100, 0.05, 1))
            end

            if Triggerbot or AutoKillMurderer then
                gun:Activate()
            end
        end
    end
end)

-- ESP
local function getRole(plr)
    if not plr.Character then return "Dead" end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return "Dead" end
    local bp = plr:FindFirstChild("Backpack")
    if plr.Character:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife")) then return "Murderer" end
    if plr.Character:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun")) then return "Sheriff" end
    return "Innocent"
end

RunService.RenderStepped:Connect(function()
    if not ESPEnabled then return end
    RainbowHue = (RainbowHue + 0.005) % 1

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end

        local char = plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if not root or not hum or hum.Health <= 0 then
            if PlayerData[plr] then
                pcall(function()
                    if PlayerData[plr].highlight then PlayerData[plr].highlight:Destroy() end
                    if PlayerData[plr].billboard then PlayerData[plr].billboard:Destroy() end
                end)
                PlayerData[plr] = nil
            end
            continue
        end

        local role = getRole(plr)
        local color = RainbowEnabled and Color3.fromHSV(RainbowHue, 0.9, 1) or Colors[role]
        local dist = 0
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then dist = math.floor((root.Position - myRoot.Position).Magnitude) end

        if not PlayerData[plr] then
            local hl = Instance.new("Highlight")
            hl.FillTransparency = 0.5
            hl.OutlineTransparency = 0.15
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = char

            local bb = Instance.new("BillboardGui")
            bb.Size = UDim2.new(0, 170, 0, 42)
            bb.StudsOffset = Vector3.new(0, 3.1, 0)
            bb.AlwaysOnTop = true
            bb.Adornee = root
            bb.Parent = char

            local lab = Instance.new("TextLabel", bb)
            lab.Size = UDim2.new(1, 0, 1, 0)
            lab.BackgroundTransparency = 1
            lab.Font = Enum.Font.GothamBold
            lab.TextSize = 13
            lab.TextStrokeTransparency = 0.35

            PlayerData[plr] = { highlight = hl, billboard = bb, label = lab }
        end

        local d = PlayerData[plr]
        if d.highlight then
            d.highlight.FillColor = color
            d.highlight.OutlineColor = color
        end
        if d.label then
            d.label.Text = string.format("%s\n[%s] %dm", plr.Name, role, dist)
            d.label.TextColor3 = color
        end
    end
end)

