-- Перетаскивание меню
local dragging, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ==================== Функции ====================

local function GetRole(player)
    local char = player.Character
    if not char then return "Dead" end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        return "Dead"
    end

    -- Проверяем инструменты
    local backpack = player:FindFirstChild("Backpack")
    local hasKnife = char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
    local hasGun = char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun"))

    if hasKnife then
        return "Murderer"
    elseif hasGun then
        return "Sheriff"
    else
        return "Innocent"
    end
end

local function CreateHighlight(adornee, color, fillTransparency)
    local highlight = Instance.new("Highlight")
    highlight.Adornee = adornee
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = fillTransparency or 0.55
    highlight.OutlineTransparency = 0.2
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = adornee
    return highlight
end

local function ClearPlayerESP()
    for _, hl in pairs(PlayerHighlights) do
        if hl and hl.Parent then
            hl:Destroy()
        end
    end
    table.clear(PlayerHighlights)
end

local function ClearGunESP()
    for _, hl in pairs(GunHighlights) do
        if hl and hl.Parent then
            hl:Destroy()
        end
    end
    table.clear(GunHighlights)
end

local function UpdatePlayerESP()
    if not ESPEnabled then
        ClearPlayerESP()
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local role = GetRole(player)
                local color = Colors[role] or Colors.Innocent

                local existing = PlayerHighlights[player]
                if existing and existing.Parent then
                    existing.FillColor = color
                    existing.OutlineColor = color
                else
                    if existing then existing:Destroy() end
                    PlayerHighlights[player] = CreateHighlight(char, color, 0.5)
                end
            else
                if PlayerHighlights[player] then
                    PlayerHighlights[player]:Destroy()
                    PlayerHighlights[player] = nil
                end
            end
        end
    end
end

local function UpdateGunESP()
    if not GunESPEnabled then
        ClearGunESP()
        return
    end

    -- Ищем пушки в мире и у игроков
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Gun" and (obj:IsA("Tool") or obj:IsA("Model") or obj:IsA("BasePart")) then
            if not GunHighlights[obj] then
                local target = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                if target then
                    GunHighlights[obj] = CreateHighlight(obj:IsA("Model") and obj or target, Colors.Gun, 0.4)
                end
            end
        end
    end

    -- Чистим уничтоженные
    for obj, hl in pairs(GunHighlights) do
        if not obj or not obj.Parent then
            if hl then hl:Destroy() end
            GunHighlights[obj] = nil
        end
    end
end

