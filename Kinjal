-- ================= ПЕРЕМЕЩЕНИЕ С ЭФФЕКТОМ =================
local dragging = false
local dragInput, dragStart, startPos
local holdStart = 0
local isReadyToDrag = false
local originalSize = Main.Size

local function StartHold()
    holdStart = tick()
    isReadyToDrag = false
    task.spawn(function()
        task.wait(0.5)
        if holdStart ~= 0 then
            isReadyToDrag = true
            -- Эффект втягивания
            TweenService:Create(Main, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 210, 0, 380)
            }):Play()
            TweenService:Create(mainStroke, TweenInfo.new(0.22), {Color = Color3.fromRGB(100, 140, 255)}):Play()
        end
    end)
end

local function StopHold()
    holdStart = 0
    if isReadyToDrag then
        TweenService:Create(Main, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = originalSize
        }):Play()
        TweenService:Create(mainStroke, TweenInfo.new(0.25), {Color = Color3.fromRGB(55, 55, 70)}):Play()
    end
    isReadyToDrag = false
    dragging = false
end

local function SetupDrag(frame)
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            StartHold()
            dragStart = input.Position
            startPos = Main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    StopHold()
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
end

SetupDrag(TopBar)
SetupDrag(DragBar)

UserInputService.InputChanged:Connect(function(input)
    if (input == dragInput) and isReadyToDrag then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Перетаскивание кружка и мини-бара
local function MakeDraggable(obj)
    local d, ds, sp
    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            d = true
            ds = input.Position
            sp = obj.Position
        end
    end)
    obj.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            d = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if d and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - ds
            obj.Position = UDim2.new(sp.X.Scale, sp.X.Offset + delta.X, sp.Y.Scale, sp.Y.Offset + delta.Y)
        end
    end)
end
MakeDraggable(CircleBtn)
MakeDraggable(MiniBar)

-- ================= ФУНКЦИИ ESP =================
local function GetRole(player)
    local char = player.Character
    if not char then return "Dead" end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return "Dead" end
    local bp = player:FindFirstChild("Backpack")
    local hasKnife = char:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife"))
    local hasGun   = char:FindFirstChild("Gun")   or (bp and bp:FindFirstChild("Gun"))
    if hasKnife then return "Murderer"
    elseif hasGun then return "Sheriff"
    else return "Innocent" end
end

local function CreateHighlight(adornee, color)
    local h = Instance.new("Highlight")
    h.Adornee = adornee
    h.FillColor = color
    h.OutlineColor = color
    h.FillTransparency = 0.55
    h.OutlineTransparency = 0.15
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = adornee
    return h
end

local function NewLine()
    local line = Drawing.new("Line")
    line.Visible = false
    line.Thickness = LineThickness
    line.Transparency = 0.8
    return line
end

local function NewTriangle()
    local t = Drawing.new("Triangle")
    t.Visible = false
    t.Filled = true
    t.Thickness = 1
    t.Transparency = 0.3
    return t
end

local function ClearPlayer(player)
    local data = PlayerData[player]
    if not data then return end
    if data.highlight then data.highlight:Destroy() end
    if data.billboard then data.billboard:Destroy() end
    if data.tracer then data.tracer:Remove() end
    if data.arrow then data.arrow:Remove() end
    if data.box then for _, l in pairs(data.box) do l:Remove() end end
    if data.skeleton then for _, l in pairs(data.skeleton) do l:Remove() end end
    PlayerData[player] = nil
end

local function ClearAllPlayers()
    for p in pairs(PlayerData) do ClearPlayer(p) end
end

local function ClearGuns()
    for obj, h in pairs(GunHighlights) do if h then h:Destroy() end end
    table.clear(GunHighlights)
end

local function GetRainbowColor()
    return Color3.fromHSV(RainbowHue, 0.9, 1)
end

local function UpdateESP()
    RainbowHue = (RainbowHue + 0.005) % 1

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if not root or not hum or hum.Health <= 0 then
            ClearPlayer(player)
            continue
        end

        local role = GetRole(player)
        local baseColor = Colors[role]
        local color = RainbowEnabled and GetRainbowColor() or baseColor
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local dist = myRoot and math.floor((root.Position - myRoot.Position).Magnitude) or 0

        if not PlayerData[player] then
            PlayerData[player] = {
                highlight = nil,
                billboard = nil,
                label = nil,
                tracer = NewLine(),
                arrow = NewTriangle(),
                box = {top = NewLine(), bottom = NewLine(), left = NewLine(), right = NewLine()},
                skeleton = {}
            }
            for i = 1, 12 do
                PlayerData[player].skeleton[i] = NewLine()
            end
        end
        local data = PlayerData[player]

        -- Highlight
        if ESPEnabled then
            if not data.highlight or not data.highlight.Parent then
                data.highlight = CreateHighlight(char, color)
            else
                data.highlight.FillColor = color
                data.highlight.OutlineColor = color
            end
        elseif data.highlight then
            data.highlight:Destroy()
            data.highlight = nil
        end

        -- Имя + Роль + Дистанция
        if ESPEnabled then
            if not data.billboard or not data.billboard.Parent then
                local bb = Instance.new("BillboardGui")
                bb.Size = UDim2.new(0, 200, 0, 48)
                bb.StudsOffset = Vector3.new(0, 3.3, 0)
                bb.AlwaysOnTop = true
                bb.MaxDistance = 1200
                bb.Adornee = root
                bb.Parent = char
                local label = Instance.new("TextLabel", bb)
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.Font = Enum.Font.GothamBold
                label.TextSize = 13
                label.TextStrokeTransparency = 0.35
                data.billboard = bb
                data.label = label
            end
            data.label.Text = string.format("%s\n[%s] %dm", player.Name, role, dist)
            data.label.TextColor3 = color
        elseif data.billboard then
            data.billboard:Destroy()
            data.billboard = nil
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
        local screenVec = Vector2.new(screenPos.X, screenPos.Y)

        -- Трейсеры + Стрелки
        if TracersEnabled and ESPEnabled then
            data.tracer.Thickness = LineThickness
            if onScreen then
                data.tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                data.tracer.To = screenVec
                data.tracer.Color = color
                data.tracer.Visible = true
                data.arrow.Visible = false
            else
                -- Стрелка за экраном
                data.tracer.Visible = false
                local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                local dir = (screenVec - center).Unit
                local edge = center + dir * (math.min(Camera.ViewportSize.X, Camera.ViewportSize.Y) * 0.42)
                local angle = math.atan2(dir.Y, dir.X)
                local size = 11
                data.arrow.PointA = edge
                data.arrow.PointB = edge + Vector2.new(math.cos(angle + 2.4)*size, math.sin(angle + 2.4)*size)
                data.arrow.PointC = edge + Vector2.new(math.cos(angle - 2.4)*size, math.sin(angle - 2.4)*size)
                data.arrow.Color = color
                data.arrow.Visible = true
            end
        else
            data.tracer.Visible = false
            data.arrow.Visible = false
        end

        -- Box ESP
        if BoxEnabled and ESPEnabled and onScreen then
            local size = Vector3.new(2.8, 5.4, 2.8)
            local cf = root.CFrame
            local corners = {
                cf * CFrame.new(-size.X/2,  size.Y/2, 0),
                cf * CFrame.new( size.X/2,  size.Y/2, 0),
                cf * CFrame.new(-size.X/2, -size.Y/2, 0),
                cf * CFrame.new( size.X/2, -size.Y/2, 0)
            }
            local sc = {}
            local ok = true
            for i, c in ipairs(corners) do
                local sp, on = Camera:WorldToViewportPoint(c.Position)
                sc[i] = Vector2.new(sp.X, sp.Y)
                if not on then ok = false end
            end
            if ok then
                data.box.top.From = sc[1]; data.box.top.To = sc[2]
                data.box.bottom.From = sc[3]; data.box.bottom.To = sc[4]
                data.box.left.From = sc[1]; data.box.left.To = sc[3]
                data.box.right.From = sc[2]; data.box.right.To = sc[4]
                for _, l in pairs(data.box) do
                    l.Color = color
                    l.Thickness = LineThickness
                    l.Visible = true
                end
            else
                for _, l in pairs(data.box) do l.Visible = false end
            end
        else
            for _, l in pairs(data.box) do l.Visible = false end
        end

        -- Skeleton ESP
        if SkeletonEnabled and ESPEnabled then
            local function getPos(partName)
                local p = char:FindFirstChild(partName)
                if p then
                    local sp, on = Camera:WorldToViewportPoint(p.Position)
                    return on and Vector2.new(sp.X, sp.Y) or nil
                end
                return nil
            end

            local head = getPos("Head")
            local torso = getPos("UpperTorso") or getPos("Torso")
            local leftArm = getPos("LeftUpperArm") or getPos("Left Arm")
            local rightArm = getPos("RightUpperArm") or getPos("Right Arm")
            local leftLeg = getPos("LeftUpperLeg") or getPos("Left Leg")
            local rightLeg = getPos("RightUpperLeg") or getPos("Right Leg")
            local leftHand = getPos("LeftHand") or getPos("Left Arm")
            local rightHand = getPos("RightHand") or getPos("Right Arm")
            local leftFoot = getPos("LeftFoot") or getPos("Left Leg")
            local rightFoot = getPos("RightFoot") or getPos("Right Leg")

            local connections = {
                {head, torso},
                {torso, leftArm}, {leftArm, leftHand},
                {torso, rightArm}, {rightArm, rightHand},
                {torso, leftLeg}, {leftLeg, leftFoot},
                {torso, rightLeg}, {rightLeg, rightFoot}
            }

            for i, conn in ipairs(connections) do
                local line = data.skeleton[i]
                if conn[1] and conn[2] then
                    line.From = conn[1]
                    line.To = conn[2]
                    line.Color = color
                    line.Thickness = LineThickness
                    line.Visible = true
                else
                    line.Visible = false
                end
            end
            for i = #connections + 1, 12 do
                data.skeleton[i].Visible = false
            end
        else
            for _, l in pairs(data.skeleton) do l.Visible = false end
        end
    end
end

local function UpdateGunESP()
    if not GunESPEnabled then ClearGuns() return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Gun" and (obj:IsA("Tool") or obj:IsA("Model")) then
            if not GunHighlights[obj] then
                GunHighlights[obj] = CreateHighlight(obj, Colors.Gun)
            end
        end
    end
    for obj, h in pairs(GunHighlights) do
        if not obj or not obj.Parent then
            if h then h:Destroy() end
            GunHighlights[obj] = nil
        end
    end
end

