function LoadTabSections(tab)
    if tab == "Main" then
        CreateTitle("Выберите раздел")
        CreateSectionButton("Player (Movement)", function()
            CurrentSection = "Player"
            ClearContent()
            LoadPlayer()
        end)
        CreateSectionButton("Скоро (Extra)", function() end)
        CreateSectionButton("Скоро (Other)", function() end)

    elseif tab == "Visuals" then
        CreateTitle("Выберите раздел")
        CreateSectionButton("ESP", function()
            CurrentSection = "ESP"
            ClearContent()
            LoadESP()
        end)
        CreateSectionButton("World / Погода", function()
            CurrentSection = "World"
            ClearContent()
            LoadWorld()
        end)
        CreateSectionButton("Themes", function()
            CurrentSection = "Themes"
            ClearContent()
            LoadThemes()
        end)

    elseif tab == "Gun" then
        CreateTitle("Выберите раздел")
        CreateSectionButton("Скоро", function() end)

    elseif tab == "Settings" then
        CreateTitle("Settings")
        CreateSlider("UI Scale (%)", 70, 130, 100, function(v)
            UIScale = v / 100
            MainFrame.Size = UDim2.new(0, 560 * UIScale, 0, 400 * UIScale)
        end)
        CreateToggle("Показать статус-бар", true, function(v)
            StatusBar.Visible = v
        end)
    end
end

-- ===================== PLAYER =====================
function LoadPlayer()
    CreateTitle("Movement")

    CreateToggle("Speed", SpeedEnabled, function(v)
        SpeedEnabled = v
        local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if h then h.WalkSpeed = v and SpeedValue or 16 end
    end)
    CreateSlider("Speed Value", 16, 200, SpeedValue, function(v)
        SpeedValue = v
        if SpeedEnabled then
            local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if h then h.WalkSpeed = v end
        end
    end)

    CreateToggle("Fly", FlyEnabled, function(v)
        FlyEnabled = v
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end
        if v then
            FlyBody = Instance.new("BodyVelocity")
            FlyBody.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            FlyBody.Parent = root
            FlyGyro = Instance.new("BodyGyro")
            FlyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            FlyGyro.P = 2000
            FlyGyro.Parent = root
            hum.PlatformStand = true
            RunService:BindToRenderStep("MM2Fly", Enum.RenderPriority.Character.Value + 1, function()
                if not FlyEnabled or not FlyBody then return end
                local dir = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
                FlyBody.Velocity = dir.Magnitude > 0 and dir.Unit * FlySpeed or Vector3.zero
                FlyGyro.CFrame = Camera.CFrame
            end)
        else
            RunService:UnbindFromRenderStep("MM2Fly")
            if FlyBody then FlyBody:Destroy() end
            if FlyGyro then FlyGyro:Destroy() end
            if hum then hum.PlatformStand = false end
        end
    end)
    CreateSlider("Fly Speed", 16, 200, FlySpeed, function(v) FlySpeed = v end)

    CreateToggle("Noclip", NoclipEnabled, function(v)
        NoclipEnabled = v
        if NoclipConn then NoclipConn:Disconnect() end
        if v then
            NoclipConn = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    for _, p in ipairs(char:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                end
            end)
        end
    end)

    CreateToggle("Invisibility", InvisEnabled, function(v)
        InvisEnabled = v
        local char = LocalPlayer.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.LocalTransparencyModifier = v and 1 or 0 end
            end
        end
    end)

    CreateToggle("Infinite Jump", InfJumpEnabled, function(v) InfJumpEnabled = v end)
    CreateSlider("Jump Power", 20, 200, JumpPowerValue, function(v)
        JumpPowerValue = v
        local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if h then h.UseJumpPower = true h.JumpPower = v end
    end)

    CreateToggle("Click TP (Ctrl+LMB / Tap)", ClickTPEnabled, function(v) ClickTPEnabled = v end)
    CreateToggle("Spin", SpinEnabled, function(v)
        SpinEnabled = v
        if SpinConn then SpinConn:Disconnect() end
        if v then
            SpinConn = RunService.RenderStepped:Connect(function()
                local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if r then r.CFrame = r.CFrame * CFrame.Angles(0, math.rad(12), 0) end
            end)
        end
    end)
    CreateToggle("Anti-AFK", AntiAFKEnabled, function(v) AntiAFKEnabled = v end)
end

