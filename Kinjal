-- ===== СОЗДАНИЕ ВКЛАДОК =====
local Tabs = {}
local CurrentTab = nil

local function CreateTab(name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -16, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    btn.Text = name
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 14
    btn.TextColor3 = Color3.fromRGB(210, 210, 220)
    btn.AutoButtonColor = false
    btn.Parent = TabsScroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local originalSize = btn.Size

    -- Эффект втягивания при наведении
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
            Size = UDim2.new(1, -28, 0, 32),
            BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        if CurrentTab ~= name then
            TweenService:Create(btn, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                Size = originalSize,
                BackgroundColor3 = Color3.fromRGB(28, 28, 36)
            }):Play()
        end
    end)

    btn.MouseButton1Click:Connect(function()
        -- Эффект при клике
        TweenService:Create(btn, TweenInfo.new(0.12, Enum.EasingStyle.Quad), {
            Size = UDim2.new(1, -36, 0, 30)
        }):Play()
        task.delay(0.12, function()
            TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Back), {
                Size = UDim2.new(1, -16, 0, 36)
            }):Play()
        end)

        -- Сброс предыдущей вкладки
        if CurrentTab and Tabs[CurrentTab] then
            TweenService:Create(Tabs[CurrentTab], TweenInfo.new(0.15), {
                BackgroundColor3 = Color3.fromRGB(28, 28, 36)
            }):Play()
        end

        CurrentTab = name
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(50, 90, 160)
        }):Play()

        -- Очищаем контент и загружаем нужный
        for _, child in ipairs(ContentScroll:GetChildren()) do
            if not child:IsA("UIListLayout") then
                child:Destroy()
            end
        end

        if name == "Main" then
            LoadPlayerSection()
        end
    end)

    Tabs[name] = btn
    return btn
end

