-- Перемещение мини-бара и кружка
local function MakeDraggable(obj)
    local dragging, dragStart, startPos
    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = obj.Position
        end
    end)
    obj.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            obj.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end
MakeDraggable(MiniBar)
MakeDraggable(CircleBtn)

-- Драг главного окна с эффектом
local holdStart, isReady = 0, false
local dragStart, startPos

local function StartHold()
    holdStart = tick()
    task.delay(0.5, function()
        if holdStart ~= 0 then
            isReady = true
            TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = UDim2.new(0, 520, 0, 370)}):Play()
            TweenService:Create(mainStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(100, 150, 255)}):Play()
        end
    end)
end

local function StopHold()
    holdStart = 0
    if isReady then
        TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Back), {
            Size = UDim2.new(0, 560 * UIScale, 0, 400 * UIScale)
        }):Play()
        TweenService:Create(mainStroke, TweenInfo.new(0.25), {Color = Color3.fromRGB(55, 55, 70)}):Play()
    end
    isReady = false
end

TopBar.InputBegan:Connect(function(i)
