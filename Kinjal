            BoxEnabled = false
            SkeletonEnabled = false
            SetState(TracerBtn, false, "Трейсеры + Стрелки: ВКЛ", "Трейсеры + Стрелки: ВЫКЛ")
            SetState(BoxBtn, false, "Box ESP: ВКЛ", "Box ESP: ВЫКЛ")
            SetState(SkeletonBtn, false, "Skeleton ESP: ВКЛ", "Skeleton ESP: ВЫКЛ")
        end
    end
end)

