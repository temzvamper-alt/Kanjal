-- Keybind
KeybindBtn.MouseButton1Click:Connect(function()
    if WaitingForKey then return end
    WaitingForKey = true
    KeybindBtn.Text = "Нажми любую клавишу..."
    KeybindBtn.BackgroundColor3 = Color3.fromRGB(90, 70, 30)
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if WaitingForKey and input.UserInputType == Enum.UserInputType.Keyboard then
        Keybind = input.KeyCode
        KeybindBtn.Text = "Keybind: " .. input.KeyCode.Name
        KeybindBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
        WaitingForKey = false
        return
    end
    if not WaitingForKey and input.KeyCode == Keybind then
        ESPEnabled = not ESPEnabled
        SetState(ESPBtn, ESPEnabled, "ESP: ВКЛ", "ESP: ВЫКЛ")
