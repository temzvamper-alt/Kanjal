local ESPBtn     = CreateButton("ESP", 48, "ESP: ВЫКЛ")
local TracerBtn  = CreateButton("Tracers", 92, "Трейсеры: ВЫКЛ")
local BoxBtn     = CreateButton("Box", 136, "Box ESP: ВЫКЛ")
local GunBtn     = CreateButton("Gun", 180, "Gun ESP: ВЫКЛ")
local KeybindBtn = CreateButton("Keybind", 224, "Keybind: Insert")

-- Перетаскивание меню
local dragging, dragStart, startPos
Main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)
Main.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ========== ФУНКЦИИ ==========
local function GetRole(player)
    local char = player.Character
    if not char then return "Dead" end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return "Dead" end

    local bp = player:FindFirstChild("Backpack")
    local hasKnife = char:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife"))
    local hasGun   = char:FindFirstChild("Gun")   or (bp and bp:FindFirstChild("Gun"))

    if hasKnife then return "Murderer"
    elseif hasGun then return "Sheriff"
    else return "Innocent" end
end

local function CreateHighlight(adornee, color)
    local h = Instance.new("Highlight")
    h.Adornee = adornee
    h.FillColor = color
    h.OutlineColor = color
    h.FillTransparency = 0.55
    h.OutlineTransparency = 0.15
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = adornee
    return h
end

local function CreateBillboard(player)
    local bb = Instance.new("BillboardGui")
    bb.Name = "ESPInfo"
    bb.Size = UDim2.new(0, 200, 0, 50)
    bb.StudsOffset = Vector3.new(0, 3.2, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = 1000

    local label = Instance.new("TextLabel", bb)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextStrokeTransparency = 0.4
    label.TextColor3 = Color3.new(1, 1, 1)
    label.Text = ""

    return bb, label
end

local function ClearPlayer(player)
    local data = PlayerData[player]
    if not data then return end
    if data.highlight then data.highlight:Destroy() end
    if data.billboard then data.billboard:Destroy() end
    if data.tracer then data.tracer:Remove() end
    if data.box then
        for _, line in pairs(data.box) do line:Remove() end
    end
    PlayerData[player] = nil
end

local function ClearAllPlayers()
    for player in pairs(PlayerData) do
        ClearPlayer(player)
    end
end

local function ClearGuns()
    for obj, h in pairs(GunHighlights) do
        if h then h:Destroy() end
    end
    table.clear(GunHighlights)
end

local function NewLine()
    local line = Drawing.new("Line")
    line.Visible = false
    line.Thickness = 1.5
    line.Transparency = 0.85
    return line
end

local function UpdateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if not root or not hum or hum.Health <= 0 then
            ClearPlayer(player)
            continue
        end

        local role = GetRole(player)
        local color = Colors[role]
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local dist = myRoot and math.floor((root.Position - myRoot.Position).Magnitude) or 0

        if not PlayerData[player] then
            PlayerData[player] = {
                highlight = nil,
                billboard = nil,
                label = nil,
                tracer = NewLine(),
                box = {
                    top = NewLine(), bottom = NewLine(),
                    left = NewLine(), right = NewLine()
                }
            }
        end
        local data = PlayerData[player]

        -- Highlight
        if ESPEnabled then
            if not data.highlight or not data.highlight.Parent then
                data.highlight = CreateHighlight(char, color)
            else
                data.highlight.FillColor = color
                data.highlight.OutlineColor = color
            end
        elseif data.highlight then
            data.highlight:Destroy()
            data.highlight = nil
        end

        -- Имя + Роль + Дистанция
        if ESPEnabled then
            if not data.billboard or not data.billboard.Parent then
                local bb, label = CreateBillboard(player)
                bb.Adornee = root
                bb.Parent = char
                data.billboard = bb
                data.label = label
            end
            data.label.Text = string.format("%s\n[%s]  %dm", player.Name, role, dist)
            data.label.TextColor3 = color
        elseif data.billboard then
            data.billboard:Destroy()
            data.billboard = nil
            data.label = nil
        end

        -- Трейсеры
        if TracersEnabled and ESPEnabled then
            local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
            data.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            data.tracer.To = Vector2.new(screenPos.X, screenPos.Y)
            data.tracer.Color = color
            data.tracer.Visible = onScreen
        else
            data.tracer.Visible = false
        end

        -- Box ESP
        if BoxEnabled and ESPEnabled then
            local size = Vector3.new(3, 5.5, 3)
            local cf = root.CFrame
            local corners = {
                cf * CFrame.new(-size.X/2,  size.Y/2, 0),
                cf * CFrame.new( size.X/2,  size.Y/2, 0),
                cf * CFrame.new(-size.X/2, -size.Y/2, 0),
                cf * CFrame.new( size.X/2, -size.Y/2, 0)
            }
            local screen = {}
            local allOnScreen = true
            for i, corner in ipairs(corners) do
                local sp, on = Camera:WorldToViewportPoint(corner.Position)
                screen[i] = Vector2.new(sp.X, sp.Y)
                if not on then allOnScreen = false end
            end
            if allOnScreen then
                data.box.top.From = screen[1];    data.box.top.To = screen[2]
                data.box.bottom.From = screen[3]; data.box.bottom.To = screen[4]
                data.box.left.From = screen[1];   data.box.left.To = screen[3]
                data.box.right.From = screen[2];  data.box.right.To = screen[4]
                for _, line in pairs(data.box) do
                    line.Color = color
                    line.Visible = true
                end
            else
                for _, line in pairs(data.box) do line.Visible = false end
            end
        else
            for _, line in pairs(data.box) do line.Visible = false end
        end
    end
end

local function UpdateGunESP()
    if not GunESPEnabled then
        ClearGuns()
        return
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Gun" and (obj:IsA("Tool") or obj:IsA("Model")) then
            if not GunHighlights[obj] then
                GunHighlights[obj] = CreateHighlight(obj, Colors.Gun)
            end
        end
    end
    for obj, h in pairs(GunHighlights) do
        if not obj or not obj.Parent then
            if h then h:Destroy() end
            GunHighlights[obj] = nil
        end
    end
end

-- ========== КНОПКИ ==========
local function SetButtonState(btn, state, onText, offText)
    if state then
        btn.Text = onText
        btn.BackgroundColor3 = Color3.fromRGB(35, 85, 50)
    else
        btn.Text = offText
        btn.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
    end
end

ESPBtn.MouseButton1Click:Connect(function()
    ESPEnabled = not ESPEnabled
    SetButtonState(ESPBtn, ESPEnabled, "ESP: ВКЛ", "ESP: ВЫКЛ")
    if not ESPEnabled then
        ClearAllPlayers()
        TracersEnabled = false
        BoxEnabled = false
        SetButtonState(TracerBtn, false, "Трейсеры: ВКЛ", "Трейсеры: ВЫКЛ")
        SetButtonState(BoxBtn, false, "Box ESP: ВКЛ", "Box ESP: ВЫКЛ")
    end
end)

TracerBtn.MouseButton1Click:Connect(function()
    if not ESPEnabled then return end
    TracersEnabled = not TracersEnabled
    SetButtonState(TracerBtn, TracersEnabled, "Трейсеры: ВКЛ", "Трейсеры: ВЫКЛ")
end)

BoxBtn.MouseButton1Click:Connect(function()
    if not ESPEnabled then return end
    BoxEnabled = not BoxEnabled
    SetButtonState(BoxBtn, BoxEnabled, "Box ESP: ВКЛ", "Box ESP: ВЫКЛ")
end)

GunBtn.MouseButton1Click:Connect(function()
    GunESPEnabled = not GunESPEnabled
    SetButtonState(GunBtn, GunESPEnabled, "Gun ESP: ВКЛ", "Gun ESP: ВЫКЛ")
    if not GunESPEnabled then ClearGuns() end
end)

-- ===== ВЫБОР КЛАВИШИ =====
KeybindBtn.MouseButton1Click:Connect(function()
    if WaitingForKey then return end
    WaitingForKey = true
    KeybindBtn.Text = "Нажми любую клавишу..."
    KeybindBtn.BackgroundColor3 = Color3.fromRGB(80, 60, 30)
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    -- Установка новой клавиши
    if WaitingForKey and input.UserInputType == Enum.UserInputType.Keyboard then
        Keybind = input.KeyCode
        KeybindBtn.Text = "Keybind: " .. input.KeyCode.Name
        KeybindBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
        WaitingForKey = false
        return
    end

    -- Срабатывание кейбинда
    if not WaitingForKey and input.KeyCode == Keybind then
        ESPEnabled = not ESPEnabled
        SetButtonState(ESPBtn, ESPEnabled, "ESP: ВКЛ", "ESP: ВЫКЛ")
        if not ESPEnabled then
            ClearAllPlayers()
            TracersEnabled = false
            BoxEnabled = false
            SetButtonState(TracerBtn, false, "Трейсеры: ВКЛ", "Трейсеры: ВЫКЛ")
            SetButtonState(BoxBtn, false, "Box ESP: ВКЛ", "Box ESP: ВЫКЛ")
        end
    end
end)

Players.PlayerRemoving:Connect(ClearPlayer)

RunService.RenderStepped:Connect(function()
    if ESPEnabled then UpdateESP() end
    if GunESPEnabled then UpdateGunESP() end
end)

print("[MM2 ESP] Загружено | Нажми на Keybind чтобы сменить клавишу")
